{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "addr-fyi",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-07-25",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": ".svelte-kit/cloudflare",
		"binding": "ASSETS"
	},
	"routes": [{ "pattern": "addr.fyi", "custom_domain": true }],
	// Per-IP limit on the upstream-backed lookups (/find, /whois, /dns,
	// /weather). Counters are per Cloudflare location and approximate.
	"ratelimits": [
		{
			"name": "LOOKUP_LIMITER",
			"namespace_id": "7301",
			"simple": { "limit": 60, "period": 60 }
		}
	],
	"observability": {
		"enabled": true
	}
}
